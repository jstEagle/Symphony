{
  "name": "@symphony/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "symphony": "./dist/index.js" },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --sourcemap --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@symphony/config": "workspace:*",
    "@symphony/daemon": "workspace:*",
    "@symphony/plugins": "workspace:*",
    "@symphony/protocol": "workspace:*",
    "@symphony/storage": "workspace:*",
    "@symphony/workflow": "workspace:*"
  },
  "devDependencies": { "tsx": "4.23.13", "tsup": "8.5.1", "typescript": "5.9.3" }
}
